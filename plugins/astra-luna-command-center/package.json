{
  "name": "astra-luna-command-center",
  "version": "0.2.0",
  "description": "GPT-6 Astra command center: bounded packets to gpt-5.6-luna or OpenAI-compatible DIY worker (astra-Diy).",
  "type": "tool",
  "platforms": ["windows", "macos", "linux", "arm"],
  "language": ["powershell", "bash", "python"],
  "scripts": {
    "doctor": "bash scripts/astra-luna.sh doctor",
    "init": "bash scripts/astra-luna.sh init",
    "diy": "bash scripts/astra-luna.sh diy-show",
    "diy:test": "bash scripts/astra-luna.sh diy-test",
    "test": "powershell -ExecutionPolicy Bypass -File tests/run-tests.ps1",
    "test:posix": "bash tests/run-tests.sh",
    "test:interop": "bash tests/run-interop.sh"
  },
  "keywords": [
    "codex",
    "agent",
    "gpt-6-astra",
    "astra",
    "luna-max",
    "gpt-5.6",
    "astra-diy",
    "openai-compatible",
    "custom-model",
    "execution-packet",
    "command-center"
  ],
  "files": [
    "scripts/astra-luna.ps1",
    "scripts/astra-luna.sh",
    "scripts/chatgpt-web.py",
    "scripts/openai-diy.py",
    "scripts/wechat-chatapi.py",
    "scripts/diy-settings.ps1",
    "agents/astra-explorer.toml",
    "agents/astra-worker.toml",
    "agents/astra-tester.toml",
    "agents/astra-reviewer.toml",
    "agents/astra-researcher.toml",
    "skills/astra-command-center",
    "skills/astra-diy",
