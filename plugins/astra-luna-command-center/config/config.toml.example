# astra-luna-command-center suggested harness configuration.
# Merge the commented lines into ~/.codex/config.toml yourself, or let `doctor`
# report what is missing. This plugin NEVER edits config.toml automatically.
#
# Topology (article: "Astra 当总指挥，Luna 批量干活"):
#   GPT-6 Astra  = the orchestrator  (this Codex session, high reasoning)
#   gpt-5.6-luna = the worker fleet  (subagents / codex exec, max reasoning)

# ---- Orchestrator: GPT-6 Astra ----
# model = "gpt-6-astra"
# model_reasoning_effort = "high"

# Let the model ask clarifying questions outside plan mode.
# [features]
# default_mode_request_user_input = true

# IMPORTANT: every value inside [features] must be a BOOLEAN. A nested table
# such as
#   [features]
#   fast_mode = true
#   [features.context_management]      <- map value inside [features]
#   experimental_mode = true
# makes the codex CLI refuse to start with
#   "Error loading configuration: ... invalid type: map, expected a boolean"
# so EVERY `codex exec` dispatch exits 1 before any model call — while the
# desktop app itself (more lenient parser) keeps running and hides the bug.
# `doctor` probes this and reports it as codex_cli_config: false (exit 2)
# with the offending lines. Flatten or remove nested [features.*] tables.

# ---- Luna worker fleet ----
# Every astra_* role agent in agents/ pins the same pair explicitly:
#   model = "gpt-5.6-luna", model_reasoning_effort = "max"
# and every local-worker dispatch passes it on the command line:
#   codex exec --model gpt-5.6-luna -c model_reasoning_effort="max"
#
# IMPORTANT (Codex-GPT56 fork): do NOT copy the upstream article's scalar
#   [agents] enabled / max_concurrent_threads_per_session /
#   default_subagent_model / default_subagent_reasoning_effort block into
#   config.toml. In this fork the [agents] table is a role-name ->
#   AgentRoleToml map; scalar keys there fail config reload with
#   "invalid type: string ..., expected struct AgentRoleToml" — and a bare
#   top-level key placed after [agents] is silently swallowed into it.
#   Role agents are provisioned as files by `init` (~/.codex/agents/astra-*.toml)
#   instead. Keep any future [agents.*] role tables at the END of config.toml.
