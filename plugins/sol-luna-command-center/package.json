{
  "name": "sol-luna-command-center",
  "version": "0.1.0",
  "description": "GPT-5.6 Sol command center: build bounded execution packets, dispatch to ChatGPT Web GPT-5.6 Luna Max or local luna_worker, ingest results, and summarize for Sol.",
  "type": "tool",
  "platforms": ["windows", "macos", "linux", "arm"],
  "language": ["powershell", "bash"],
  "scripts": {
    "doctor": "bash scripts/sol-luna.sh doctor",
    "init": "bash scripts/sol-luna.sh init",
    "test": "powershell -ExecutionPolicy Bypass -File tests/run-tests.ps1",
    "test:posix": "bash tests/run-tests.sh",
    "test:interop": "bash tests/run-interop.sh"
  },
  "keywords": [
    "codex",
    "agent",
    "chatgpt",
    "gpt-5.6",
    "luna-max",
    "execution-packet",
    "sol",
    "command-center"
  ],
  "files": [
    "scripts/sol-luna.ps1",
    "scripts/sol-luna.sh",
    "agents/luna-worker.toml",
    "skills/sol-command-center",
    "templates/AGENTS.md",
    "config/config.toml.example",
    "examples/fix-http-reset.spec.json",
    "tests/run-tests.ps1",
    "tests/run-tests.sh",
    "tests/run-interop.sh",
    "README.md",
    "LICENSE",
    ".codex-plugin/plugin.json"
  ]
}